---
import '../styles/global.css';
import type { Lang } from '../shared/protocol.ts';
import { ROUTES, GAMES, asset, type PageKey } from '../site/routes.ts';
import { TEXT } from '../site/text.ts';

type Props = {
  lang: Lang;
  page: PageKey | 'room' | '404';
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: object[];
};

const { lang, page, title, description, noindex = false, jsonLd = [] } = Astro.props;
const text = TEXT[lang];
const site = Astro.site!;
const routes = page in ROUTES ? ROUTES[page as PageKey] : null;
const canonical = routes ? new URL(routes[lang], site).href : null;
const other: Lang = lang === 'en' ? 'ru' : 'en';
const image = new URL(asset('/og.png'), site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {
      routes && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(routes.en, site).href} />
          <link rel="alternate" hreflang="ru" href={new URL(routes.ru, site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(routes.en, site).href} />
        </>
      )
    }
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('/icon-192.png')} />
    <link rel="manifest" href={asset('/manifest.webmanifest')} />
    <meta name="theme-color" content="#5b3df5" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Workbench Games" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href={ROUTES.home[lang]}>
        <img src={asset('/favicon.svg')} width="28" height="28" alt="" />
        <span>{text.brand}</span>
      </a>
      <nav class="site-nav" aria-label="Games">
        {GAMES.map((g) => <a href={ROUTES[g][lang]} aria-current={page === g ? 'page' : undefined}>{text.nav[g]}</a>)}
        {routes && <a href={routes[other]} hreflang={other} lang={other}>{text.langOther}</a>}
      </nav>
    </header>
    {
      routes && (
        <p class="lang-hint" hidden data-lang-hint={other}>
          <a href={routes[other]} hreflang={other}>{text.langSuggest}</a>
        </p>
      )
    }
    <main><slot /></main>
    <footer class="site-footer">
      <p>{text.footer}</p>
      <p>
        <a href={ROUTES.about[lang]}>{text.about}</a> · <a href={ROUTES.privacy[lang]}>{text.privacy}</a> · <span>© {new Date().getFullYear()} Workbench Soft</span>
      </p>
    </footer>
    <script>
      // Points a reader to the page in their own language. Search engines get the same page for every visitor.
      const hint = document.querySelector<HTMLElement>('[data-lang-hint]');
      if (hint && navigator.language.toLowerCase().startsWith(hint.dataset.langHint!)) hint.hidden = false;
    </script>
  </body>
</html>
