---
import Page from '../layouts/Page.astro';
import type { SiteLang } from '../shared/protocol.ts';
import { INFO, type InfoKey } from '../site/info.ts';
import { TEXT } from '../site/text.ts';

type Props = { lang: SiteLang; page: InfoKey };
const { lang, page } = Astro.props;
const info = INFO[page][lang];
---

<Page lang={lang} page={page} title={`${info.title} | Workbench Games`} description={info.description}>
  <article class="prose">
    <h1>{info.title}</h1>
    {
      info.sections.map((s) => (
        <section>
          {s.h && <h2>{s.h}</h2>}
          {s.p.map((p) => <p set:html={p} />)}
        </section>
      ))
    }
    {page === 'privacy' && (
      <button id="ad-choices" class="btn" type="button" hidden>
        {TEXT[lang].adChoices}
      </button>
    )}
  </article>
</Page>

<script>
  import { adChoicesNeeded, showAdChoices } from '../game/admob.ts';
  import { isNative } from '../game/platform.ts';

  // Google's consent rules ask the apps for a way to change the answer where the consent message shows.
  const button = document.querySelector<HTMLButtonElement>('#ad-choices');
  if (button && isNative())
    void adChoicesNeeded().then((needed) => {
      button.hidden = !needed;
      button.addEventListener('click', () => void showAdChoices().catch(() => undefined));
    });
</script>
