{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["*.ts", "worker-configuration.d.ts", "../src/shared", "../src/server", "../src/words"],
  "exclude": ["../src/**/*.test.ts", "../src/server/test-helpers.ts"]
}
