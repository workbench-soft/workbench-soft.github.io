---
import "../styles/global.css";
import { email } from "../data/studio";
import { langOf, locales, ogLocales, tags, type Lang } from "../i18n/locales";
import { ui } from "../i18n";

interface Props {
  title: string;
  description: string;
  /** The page path without the language prefix, such as /skyaltar/astrology/. */
  path?: string;
  /** The languages the page exists in, for the hreflang links. */
  langs?: readonly Lang[];
  type?: "website" | "article";
  /** More JSON-LD blocks, such as an Article. */
  schema?: object[];
  /** The share picture, a path on this site. The studio card is the default. */
  image?: string;
  /** Keeps the page out of search, such as the 404 page. */
  noindex?: boolean;
}

const { title, description, path = "/", langs = locales, type = "website", schema = [], image: picture, noindex = false } = Astro.props;
const at = (l: Lang) => new URL(l === "en" ? path : `/${l}${path}`, Astro.site);
const lang = langOf(Astro.currentLocale);
const url = new URL(Astro.url.pathname, Astro.site);
const home = Astro.site!.href;
const image = new URL(picture ?? "/og.png", Astro.site);
// The site and the studio behind it. Article blocks point at the studio through its @id.
const site = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${home}#org`,
      name: "Workbench Soft",
      url: home,
      logo: new URL("/apple-touch-icon.png", Astro.site).href,
      email,
      description: ui(lang).meta.org,
      sameAs: ["https://github.com/workbench-soft"],
    },
    {
      "@type": "WebSite",
      "@id": `${home}#site`,
      name: "Workbench Soft",
      url: home,
      inLanguage: [...langs.map((l) => tags[l])],
      publisher: { "@id": `${home}#org` },
    },
  ],
};
---

<!doctype html>
<html lang={tags[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={url} />}
    {!noindex && langs.map((l) => <link rel="alternate" hreflang={tags[l]} href={at(l)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={at("en")} />}
    <meta name="theme-color" content="#04060b" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:site_name" content="Workbench Soft" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    {!picture && <meta property="og:image:width" content="1200" />}
    {!picture && <meta property="og:image:height" content="630" />}
    {!picture && <meta property="og:image:alt" content="Workbench Soft" />}
    <meta property="og:locale" content={ogLocales[lang]} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(site)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>
    <slot />
  </body>
</html>
