---
// The About and Privacy pages of the studio site, in each language.
import Base from "../layouts/Base.astro";
import LangPicker from "../components/LangPicker.astro";
import { email } from "../data/studio";
import { locales, pathOf, type Lang } from "../i18n/locales";
import { catalogs } from "./i18n";

interface Props {
  lang: Lang;
  page: "about" | "privacy";
}

const { lang, page } = Astro.props;
const t = catalogs[lang];
const text = t[page];
const path = page === "about" ? "/about/" : "/privacy-policy/";
const href = (l: Lang) => (l === "en" ? path : `/${l}${path}`);
const links: Record<string, string> = {
  email: `<a href="mailto:${email}">${email}</a>`,
  mcp: `<a href="/privacy">workbench-soft.com/privacy</a>`,
};
const html = (p: string) => p.replace(/\{(\w+)\}/g, (_, k: string) => links[k] ?? k);
---

<Base title={`${text.title} | Workbench Soft`} description={text.description} path={path}>
  <header class="top">
    <div class="bar">
      <a class="brand" href={pathOf(lang)}>{t.home}</a>
      <LangPicker lang={lang} items={locales.map((l) => ({ lang: l, href: href(l) }))} label={t.language} />
    </div>
  </header>
  <main class="page">
    <h1>{text.title}</h1>
    {
      text.sections.map((s) => (
        <section>
          {"h" in s && <h2>{s.h}</h2>}
          {s.p.map((p) => (
            <p set:html={html(p)} />
          ))}
        </section>
      ))
    }
  </main>
  <footer class="foot">
    <span>© {new Date().getFullYear()} Workbench Soft</span>
  </footer>
</Base>

<style>
  .bar, .page, .foot { max-width: 820px; margin: 0 auto; padding: 0 var(--gutter); }
  .top { border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 56px; }
  .brand { font-family: var(--mono); letter-spacing: 0.04em; color: var(--text); text-decoration: none; font-weight: 500; }
  .page { padding-top: 40px; padding-bottom: 40px; }
  h1 { font-size: clamp(30px, 5vw, 44px); line-height: 1.12; margin: 8px 0 14px; }
  h2 { font-size: 22px; margin: 32px 0 10px; }
  p { color: var(--soft); font-size: 17px; line-height: 1.7; }
  .page :global(a) { color: var(--cyan); overflow-wrap: anywhere; }
  .foot { padding-top: 24px; padding-bottom: 40px; border-top: 1px solid var(--line); color: var(--dim); font: 500 12px var(--mono); }
</style>
