---
import { steps } from "../data/studio";
---

<section class="block" id="process">
  <div class="wrap">
    <div class="eyebrow rv">03 / Process</div>
    <h2 class="rv">From the first spec to the store</h2>
    <p class="intro rv">Each project above went through the same steps. A client project goes through them too, and sees each one.</p>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step rv">
            <div class="n">{String(i + 1).padStart(2, "0")}</div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <div class="line" />
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 16px; list-style: none; margin: 0; padding: 0; }
  .step { padding: 26px 24px; border: 1px solid var(--line); border-radius: 18px; background: rgb(8 12 22 / 0.7); }
  .n {
    font: 700 42px/1 var(--mono);
    background: linear-gradient(180deg, var(--text), rgb(232 238 255 / 0.1));
    background-clip: text;
    color: transparent;
  }
  h3 { margin: 20px 0 8px; font-size: 1.2rem; letter-spacing: -0.02em; }
  p { margin: 0; color: var(--muted); font-size: 0.97rem; }
  .line {
    height: 2px;
    margin-top: 22px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--cyan), var(--violet));
    transform-origin: left;
  }
  @supports (animation-timeline: view()) {
    .line { animation: draw linear both; animation-timeline: view(); animation-range: entry 20% cover 45%; }
  }
  @keyframes draw { from { transform: scaleX(0.1); } }
</style>
