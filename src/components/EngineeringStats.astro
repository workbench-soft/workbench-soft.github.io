---
import { codeStats } from "../data/code-stats";
import { engineeringIn } from "../data/engineering";
import type { Metric } from "../data/engineering/types";
import { langOf, tags } from "../i18n/locales";

const lang = langOf(Astro.currentLocale);
const t = engineeringIn(lang).numbers;
const tag = tags[lang];
const s = codeStats;
const order: Metric[] = ["lines", "files", "functions", "types", "tests", "modules", "smallFiles", "medianLines", "specs", "docs", "commits", "prs"];
const show = (m: Metric, n: number) =>
  m === "smallFiles" ? new Intl.NumberFormat(tag, { style: "percent" }).format(n / 100) : n.toLocaleString(tag);
// The top languages get a band each, and the rest share one.
const top = s ? s.languages.slice(0, 6) : [];
const rest = s ? s.lines - top.reduce((n, l) => n + l.lines, 0) : 0;
const bands = [...top, ...(rest > 0 ? [{ name: t.other, lines: rest }] : [])];
const share = (n: number) => new Intl.NumberFormat(tag, { style: "percent", maximumFractionDigits: 1 }).format(n / s!.lines);
---

{
  s && (
    <div class="stats rv">
      <h3>{t.title}</h3>
      <dl class="tiles">
        {order.map((m) => (
          <div class="tile spot" title={t.metrics[m][1]}>
            <dt>{t.metrics[m][0]}</dt>
            <dd>{show(m, s[m])}</dd>
            <p>{t.metrics[m][1]}</p>
          </div>
        ))}
      </dl>
      <h4>{t.languages}</h4>
      <div class="bar" aria-hidden="true">
        {bands.map((b, i) => <span class={`b${i}`} style={`flex: ${b.lines}`} />)}
      </div>
      <ul class="legend">
        {bands.map((b, i) => (
          <li><i class={`b${i}`} />{b.name} <b>{share(b.lines)}</b></li>
        ))}
      </ul>
      <p class="source">
        {t.source.replace("{repos}", String(s.repos)).replace("{date}", new Intl.DateTimeFormat(tag, { dateStyle: "long" }).format(new Date(s.updated)))}
      </p>
    </div>
  )
}

<style>
  .stats { margin: 0 0 56px; }
  h3 { font-size: 1.2rem; margin: 0 0 18px; letter-spacing: -0.02em; }
  h4 { font: 500 12px var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin: 28px 0 12px; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr)); gap: 12px; margin: 0; }
  .tile { padding: 18px; border: 1px solid var(--line); border-radius: 14px; background: rgb(var(--panel) / 0.7); }
  dt { font: 500 11px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  dd { margin: 8px 0 6px; font: 700 1.7rem/1.1 var(--mono); color: var(--text); }
  .tile p { margin: 0; font-size: 0.82rem; color: var(--dim); }
  .bar { display: flex; height: 12px; border-radius: 999px; overflow: hidden; gap: 2px; }
  .legend { display: flex; flex-wrap: wrap; gap: 8px 18px; list-style: none; margin: 12px 0 0; padding: 0; font: 500 12px var(--mono); color: var(--soft); }
  .legend i { display: inline-block; width: 9px; height: 9px; border-radius: 3px; margin-right: 7px; }
  .legend b { color: var(--muted); font-weight: 500; }
  .b0 { background: var(--cyan); }
  .b1 { background: var(--violet); }
  .b2 { background: var(--lime); }
  .b3 { background: #ff8fb1; }
  .b4 { background: #ffc85c; }
  .b5 { background: #6fa8ff; }
  .b6 { background: var(--dim); }
  .source { margin: 16px 0 0; font-size: 0.85rem; color: var(--dim); }
  @media (min-width: 1100px) { .tiles { grid-template-columns: repeat(6, 1fr); } }
  @media (max-width: 480px) { dd { font-size: 1.35rem; } .tile { padding: 14px; } }
</style>
