---
import { projects, featureCount } from "../data/projects";
import { devicePlatforms, mailto } from "../data/studio";
import { langOf } from "../i18n/locales";
import { ui } from "../i18n";

const t = ui(langOf(Astro.currentLocale));
const platforms = new Set(projects.flatMap((p) => p.platforms).filter((p) => devicePlatforms.includes(p)));
const stats = [
  { value: projects.length, label: t.hero.projects },
  { value: projects.reduce((n, p) => n + featureCount(p), 0), label: t.hero.features },
  { value: platforms.size, label: t.hero.platforms },
  { value: 0, label: t.hero.ads },
];
const lines = t.hero.lines;
---

<header class="hero" id="top">
  <canvas id="field" aria-hidden="true"></canvas>
  <div class="hud tl" aria-hidden="true">WS://studio <b>online</b></div>
  <div class="hud tr" aria-hidden="true">Local <b id="clock">--:--:--</b><br />Render <b id="renderer">CSS</b></div>
  <div class="wrap">
    <span class="status"><span class="dot" aria-hidden="true"></span>{t.hero.status}</span>
    <h1 aria-label={lines.join(" ")}>
      {lines.map((l, i) => <span class:list={{ grad: i === lines.length - 1 }} data-scramble aria-hidden="true">{l}</span>)}
    </h1>
    <p class="lead">{t.hero.lead}</p>
    <div class="cta">
      <a class="btn pri" href={mailto(t.contact.subject)}>
        {t.hero.start}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <a class="btn" href="#projects">{t.hero.work}</a>
    </div>
    <dl class="stats">
      {stats.map((s) => <div><dt>{s.label}</dt><dd data-count={s.value}>{s.value}</dd></div>)}
    </dl>
  </div>
</header>

<script>
  import { startField } from "../scripts/field";

  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  try {
    if (startField(document.querySelector<HTMLCanvasElement>("#field")!, still)) {
      document.querySelector("#renderer")!.textContent = "WebGL2";
    }
  } catch {
    // The CSS backdrop stays when the GPU refuses the shader.
  }

  const clock = document.querySelector("#clock")!;
  const tick = () => (clock.textContent = new Date().toLocaleTimeString("en-GB"));
  tick();
  setInterval(tick, 1000);

  if (!still) {
    // The headline decodes from random signs.
    const signs = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789<>/#%*";
    document.querySelectorAll<HTMLElement>("[data-scramble]").forEach((el, i) => {
      const text = el.textContent ?? "";
      const start = performance.now() + i * 160;
      const step = (now: number) => {
        const p = Math.min(1, Math.max(0, (now - start) / 900));
        const n = Math.floor(p * text.length);
        const rest = Array.from(text.slice(n), (ch) => (ch === " " ? " " : signs[(Math.random() * signs.length) | 0]));
        el.textContent = text.slice(0, n) + rest.join("");
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });

    // The counts roll up to the numbers the build wrote.
    document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
      const to = Number(el.dataset.count);
      const start = performance.now() + 500;
      const step = (now: number) => {
        const p = Math.min(1, Math.max(0, (now - start) / 1400));
        el.textContent = String(Math.round(to * (1 - (1 - p) ** 3)));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }
</script>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; padding: 120px 0 72px; }
  #field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    background:
      radial-gradient(70% 50% at 50% 60%, rgb(92 242 255 / 0.12), transparent 70%),
      radial-gradient(50% 40% at 80% 20%, rgb(169 139 255 / 0.14), transparent 70%);
    opacity: 0;
    transition: opacity 1.4s ease;
  }
  #field:global(.live) { opacity: 1; }
  @media (scripting: none) { #field { opacity: 1; } }
  .hero::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 45%;
    background: linear-gradient(transparent, var(--bg));
    z-index: -1;
    pointer-events: none;
  }
  .hud { position: absolute; font: 500 11px var(--mono); letter-spacing: 0.12em; color: var(--dim); text-transform: uppercase; }
  .tl { top: 84px; left: var(--gutter); }
  .tr { top: 84px; right: var(--gutter); text-align: right; }
  .hud b { color: var(--cyan); font-weight: 500; }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 500 12px var(--mono);
    letter-spacing: 0.06em;
    color: var(--soft);
    padding: 7px 14px 7px 12px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: rgb(8 12 22 / 0.7);
    backdrop-filter: blur(6px);
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--lime); animation: ping 2s infinite; }
  @keyframes ping {
    0% { box-shadow: 0 0 0 0 rgb(197 255 74 / 0.6); }
    70%, 100% { box-shadow: 0 0 0 10px rgb(197 255 74 / 0); }
  }
  h1 { font-size: clamp(2.9rem, 8.6vw, 7.6rem); line-height: 0.92; letter-spacing: -0.045em; margin: 26px 0 28px; font-weight: 700; }
  h1 span { display: block; }
  .grad {
    background: linear-gradient(92deg, var(--cyan) 10%, var(--violet) 55%, var(--lime));
    background-clip: text;
    color: transparent;
  }
  .lead {
    max-width: 40rem;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: var(--soft);
    margin: 0 0 36px;
    text-shadow: 0 0 18px var(--bg), 0 0 6px var(--bg);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 64px 0 0;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgb(8 12 22 / 0.55);
    backdrop-filter: blur(8px);
  }
  .stats div { display: flex; flex-direction: column-reverse; padding: 18px 22px; border-left: 1px solid var(--line); }
  .stats div:first-child { border-left: 0; }
  .stats dd { margin: 0; font: 700 clamp(1.8rem, 3.4vw, 2.6rem)/1 var(--sans); letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .stats dt { margin-top: 6px; font: 500 11px var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  @media (max-width: 640px) {
    .tr { display: none; }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stats div:nth-child(3) { border-left: 0; }
    .stats div:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
</style>
