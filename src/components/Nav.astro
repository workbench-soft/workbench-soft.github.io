---
import { langOf, locales, names, pathOf, tags } from "../i18n/locales";
import { projectsIn, ui } from "../i18n";

const lang = langOf(Astro.currentLocale);
const t = ui(lang).nav;
const games = projectsIn(lang).find((p) => p.id === "games")!.links;
const links = [
  { href: "#services", label: t.services },
  { href: "#projects", label: t.projects },
  { href: "#process", label: t.process },
  { href: "#contact", label: t.contact },
];
---

<nav class="nav" aria-label={t.main}>
  <div class="wrap">
    <a class="brand" href="#top"><span class="mark" aria-hidden="true">WS</span>Workbench Soft</a>
    <ul class="links">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <details class="menu games">
      <summary>{t.games}<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></summary>
      <ul>
        {games.map((g) => <li><a href={g.href}>{g.label}</a></li>)}
        <li class="sep"><a href="#games">{t.gamesPanel}</a></li>
      </ul>
    </details>
    <button class="kbtn" type="button" data-palette aria-label={t.searchLabel}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <span class="label">{t.search}</span><kbd>Ctrl K</kbd>
    </button>
    <details class="menu lang">
      <summary class="kbtn" aria-label={t.language} title={t.language}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg>
        {lang.toUpperCase()}
      </summary>
      <ul>
        {
          locales.map((l) => (
            <li>
              <a href={pathOf(l)} hreflang={tags[l]} lang={tags[l]} aria-current={l === lang ? "page" : undefined}>
                {names[l]}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</nav>

<script>
  // Each menu closes on a click outside it, on a pick, or on Escape.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>(".nav .menu")) {
    document.addEventListener("click", (e) => {
      if (!menu.contains(e.target as Node) || (e.target as Element).closest("a")) menu.open = false;
    });
    menu.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || !menu.open) return;
      menu.open = false;
      menu.querySelector("summary")!.focus();
    });
  }

  const links = [...document.querySelectorAll<HTMLAnchorElement>(".nav .links a")];
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        for (const a of links) a.classList.toggle("on", a.hash === `#${e.target.id}`);
      }
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );
  for (const a of links) {
    const target = document.querySelector(a.hash);
    if (target) io.observe(target);
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    height: 64px;
    background: rgb(4 6 11 / 0.6);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--line);
  }
  .wrap { height: 100%; display: flex; align-items: center; gap: 28px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 700; letter-spacing: -0.01em; white-space: nowrap; }
  .mark {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    background: conic-gradient(from 210deg, var(--cyan), var(--violet), var(--lime), var(--cyan));
    color: var(--bg);
    font: 700 12px var(--mono);
    box-shadow: 0 0 24px rgb(92 242 255 / 0.35);
  }
  .links { display: flex; gap: 22px; list-style: none; margin: 0 0 0 auto; padding: 0; }
  .links a { text-decoration: none; color: var(--muted); font: 500 13px var(--mono); letter-spacing: 0.04em; transition: color 0.2s; white-space: nowrap; }
  .links a:hover, .links a.on { color: var(--text); }
  .menu { position: relative; }
  .menu summary { list-style: none; cursor: pointer; }
  .menu summary::-webkit-details-marker { display: none; }
  .lang { margin-left: -16px; }
  .lang summary { gap: 8px; }
  .lang[open] summary { color: var(--text); border-color: var(--cyan); }
  .games { margin-left: -6px; }
  .games summary { display: flex; align-items: center; gap: 6px; color: var(--muted); font: 500 13px var(--mono); letter-spacing: 0.04em; white-space: nowrap; transition: color 0.2s; }
  .games summary:hover, .games[open] summary { color: var(--text); }
  .games[open] svg { rotate: 180deg; }
  .games ul { left: 0; right: auto; min-width: 220px; }
  .games a { white-space: nowrap; }
  .menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 180px;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: rgb(10 14 26 / 0.97);
    border: 1px solid var(--line-2);
    border-radius: 12px;
    box-shadow: 0 20px 60px -10px rgb(0 0 0 / 0.8);
  }
  .menu a { display: block; padding: 8px 12px; border-radius: 8px; text-decoration: none; color: var(--soft); font-size: 14px; }
  .menu a:hover { background: rgb(255 255 255 / 0.05); color: var(--text); }
  .lang a[aria-current] { color: var(--cyan); }
  .sep { margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--line); }
  @media (max-width: 980px) {
    .links { display: none; }
    .games { margin-left: auto; }
    .games ul { left: auto; right: 0; }
  }
  @media (max-width: 640px) {
    .label, .kbtn[data-palette] kbd { display: none; }
  }
</style>
