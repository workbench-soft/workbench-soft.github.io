---
import { services, type Icon } from "../data/studio";
import { projects } from "../data/projects";

const icons: Record<Icon, string> = {
  phone: '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M10.5 18.5h3"/>',
  browser: '<rect x="2.5" y="4" width="19" height="15" rx="2.5"/><path d="M2.5 8.5h19M6 6.3h.01M8.5 6.3h.01"/>',
  code: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>',
  growth: '<path d="M4 20 10 9l4 6 2-3 4 8"/><path d="M15 4h5v5"/>',
  gear: '<circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"/>',
};
const nameOf = (id: string) => projects.find((p) => p.id === id)?.name ?? id;
---

<section class="block" id="services">
  <div class="wrap">
    <div class="eyebrow rv">01 / Services</div>
    <h2 class="rv">What the studio builds for you</h2>
    <p class="intro rv">The same team that shipped the apps below can build yours. Each line of work links to the projects that prove it.</p>
    <div class="grid">
      {
        services.map((s) => (
          <article class="card spot rv">
            <div class="ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" set:html={icons[s.icon]} />
            </div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <ul class="proof">
              {s.proof.map((id) => <li><a href={`#${id}`}>{nameOf(id)}</a></li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 16px; }
  .card {
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 26px;
    background: linear-gradient(180deg, rgb(14 20 36 / 0.7), rgb(8 12 22 / 0.7));
    transition: border-color 0.3s, translate 0.3s;
  }
  .card:hover { border-color: var(--line-2); translate: 0 -3px; }
  h3 { font-size: 1.35rem; letter-spacing: -0.02em; margin: 26px 0 10px; }
  p { color: var(--muted); margin: 0 0 20px; font-size: 0.98rem; }
  .ico {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-2);
    background: rgb(92 242 255 / 0.06);
    color: var(--cyan);
  }
  .ico svg { width: 22px; height: 22px; }
  .proof { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .proof a {
    font: 500 11px var(--mono);
    letter-spacing: 0.04em;
    color: var(--soft);
    text-decoration: none;
    padding: 4px 9px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
  }
  .proof a:hover { border-color: var(--cyan); color: var(--cyan); }
</style>
