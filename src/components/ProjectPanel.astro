---
import { Image } from "astro:assets";
import type { Project } from "../data/projects";
import { iconOf, shotsOf } from "../data/media";
import { langOf } from "../i18n/locales";
import { ui } from "../i18n";

interface Props {
  project: Project;
  number: number;
}

const { project: p, number } = Astro.props;
const t = ui(langOf(Astro.currentLocale)).projects;
const no = String(number).padStart(2, "0");
const icon = iconOf(p.id);
const shots = shotsOf(p.id);
---

<article class="proj" id={p.id} data-kind={p.kind} style={`--hue: ${p.hue}`}>
  <div class="meta">
    <div class="code">{no} / {p.code}</div>
    <div class="head">
      {icon ? <Image class="icon" src={icon} alt="" width={64} height={64} densities={[1, 2]} /> : <span class="icon mono" aria-hidden="true">{p.code}</span>}
      <h3>{p.name}</h3>
    </div>
    <p class="tag">{p.tagline}</p>
    <dl>
      <div><dt>{t.platforms}</dt><dd>{p.platforms.map((x) => <span>{x}</span>)}</dd></div>
      <div><dt>{t.stack}</dt><dd>{p.stack.map((x) => <span>{x}</span>)}</dd></div>
    </dl>
    {
      p.links.length > 0 && (
        <div class="links">
          {p.links.map((l) => <a href={l.href}>{l.label} ↗</a>)}
        </div>
      )
    }
  </div>
  <div>
    <p class="lede">{p.lede}</p>
    {
      shots.length > 0 && (
        <ul class="shots">
          {shots.map((s, i) => (
            <li>
              <a href={s.src} target="_blank" rel="noopener">
                <Image src={s} alt={t.shot.replace("{n}", String(i + 1)).replace("{name}", p.name)} height={300} densities={[1, 2]} loading="lazy" />
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <ul class="feats">
      {
        p.groups.map((g) => (
          <>
            {g.title && <li class="sub">{g.title}</li>}
            {g.features.map((f) => (
              <li class="feat spot">
                <b>{f.name}</b>
                <span>{f.text}</span>
              </li>
            ))}
          </>
        ))
      }
    </ul>
  </div>
</article>

<style>
  .proj {
    --acc: oklch(0.85 0.14 var(--hue));
    --acc-a: oklch(0.85 0.14 var(--hue) / 0.14);
    --glow: oklch(0.85 0.14 var(--hue) / 0.12);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    padding: 44px 0;
    border-top: 1px solid var(--line);
  }
  .proj[hidden] { display: none; }
  @container projects (min-width: 900px) {
    .proj { grid-template-columns: minmax(250px, 330px) minmax(0, 1fr); gap: clamp(28px, 4vw, 56px); }
    .meta { position: sticky; top: 92px; align-self: start; }
  }
  .code { display: flex; align-items: center; gap: 10px; font: 500 12px var(--mono); letter-spacing: 0.12em; color: var(--acc); }
  .code::before { content: ""; width: 10px; height: 10px; border-radius: 3px; background: var(--acc); box-shadow: 0 0 16px var(--acc); }
  .head { display: flex; align-items: center; gap: 14px; margin: 16px 0 12px; }
  .icon { flex: none; width: 56px; height: 56px; border-radius: 14px; box-shadow: 0 0 0 1px var(--line), 0 8px 24px var(--glow); }
  .mono { display: grid; place-items: center; font: 600 13px var(--mono); letter-spacing: 0.06em; color: var(--acc); background: var(--acc-a); }
  h3 { font-size: clamp(1.9rem, 3.4vw, 2.6rem); letter-spacing: -0.035em; line-height: 1; margin: 0; }
  .shots { list-style: none; margin: 0 0 24px; padding: 0 0 10px; display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; }
  .shots li { flex: none; scroll-snap-align: start; }
  .shots img { display: block; height: 300px; width: auto; border-radius: 12px; border: 1px solid var(--line); transition: border-color 0.2s; }
  .shots a:hover img { border-color: var(--acc); }
  @media (max-width: 640px) { .shots img { height: 240px; } }
  .tag { color: var(--soft); margin: 0 0 22px; font-size: 1.05rem; }
  dl { margin: 0 0 22px; display: grid; gap: 12px; }
  dt { font: 500 10.5px var(--mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); margin-bottom: 4px; }
  dd { margin: 0; display: flex; flex-wrap: wrap; gap: 5px; }
  dd span { font: 500 11.5px var(--mono); color: var(--soft); padding: 3px 8px; border-radius: 6px; background: rgb(255 255 255 / 0.04); border: 1px solid var(--line); }
  .links { display: flex; flex-wrap: wrap; gap: 8px; }
  .links a {
    font: 600 13px var(--sans);
    text-decoration: none;
    padding: 9px 14px;
    border-radius: 10px;
    border: 1px solid var(--acc);
    color: var(--acc);
    background: var(--acc-a);
    transition: background 0.2s, color 0.2s;
  }
  .links a:hover { background: var(--acc); color: var(--bg); }
  .lede { font-size: 1.12rem; color: var(--soft); margin: 0 0 24px; max-width: 46rem; }
  .feats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
  }
  .feat { background: var(--bg-2); padding: 18px 20px; transition: background 0.25s; }
  .feat:hover { background: linear-gradient(160deg, var(--acc-a), var(--bg-2) 70%); }
  .feat b { display: block; font: 500 11.5px var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--acc); margin-bottom: 7px; }
  .feat span { font-size: 14.5px; color: var(--soft); }
  .sub {
    grid-column: 1 / -1;
    padding: 12px 20px;
    background: var(--bg-3);
    font: 500 11px var(--mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  :global(.flash) { animation: flash 1.8s ease-out; }
  @keyframes flash {
    0%, 30% { box-shadow: inset 0 0 0 2px var(--acc, var(--cyan)); background: var(--acc-a, rgb(92 242 255 / 0.14)); }
  }
</style>
