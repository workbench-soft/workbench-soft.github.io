---
import { email } from "../data/studio";
import { langOf } from "../i18n/locales";
import { ui } from "../i18n";

const lang = langOf(Astro.currentLocale);
const t = ui(lang).feedback;
const [before, after] = t.failed.split("{email}");
---

<button class="fab" type="button" data-feedback aria-haspopup="dialog">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"></path></svg>
  <span>{t.open}</span>
</button>

<dialog id="feedback" aria-labelledby="fb-title">
  <form id="fb-form" data-lang={lang}>
    <header>
      <h2 id="fb-title">{t.title}</h2>
      <button class="x" type="button" value="close" aria-label={t.close}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </header>
    <p class="intro">{t.intro}</p>
    <label>
      <span>{t.message}</span>
      <textarea name="message" rows="5" maxlength="5000" required></textarea>
    </label>
    <label>
      <span>{t.email}</span>
      <input name="email" type="email" autocomplete="email" maxlength="200" />
    </label>
    <input class="honey" name="_honey" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <p class="status" role="status" aria-live="polite">
      <span class="ok" hidden>{t.sent}</span>
      <span class="err" hidden>{before}<a href={`mailto:${email}`}>{email}</a>{after}</span>
    </p>
    <div class="cta">
      <button class="btn pri" type="submit" data-idle={t.send} data-busy={t.sending}>{t.send}</button>
    </div>
  </form>
</dialog>

<script>
  import { email } from "../data/studio";

  const dlg = document.querySelector<HTMLDialogElement>("#feedback")!;
  const form = document.querySelector<HTMLFormElement>("#fb-form")!;
  const send = form.querySelector<HTMLButtonElement>("[type=submit]")!;
  const ok = form.querySelector<HTMLElement>(".ok")!;
  const err = form.querySelector<HTMLElement>(".err")!;

  function open() {
    ok.hidden = err.hidden = true;
    if (!dlg.open) dlg.showModal();
    form.message.focus();
  }

  // A #feedback link from any page or app opens the form.
  const fromHash = () => location.hash === "#feedback" && open();
  fromHash();
  addEventListener("hashchange", fromHash);
  dlg.addEventListener("close", () => {
    if (location.hash === "#feedback") history.replaceState(null, "", location.pathname + location.search);
  });
  dlg.addEventListener("click", (e) => {
    if (e.target === dlg || (e.target as Element).closest(".x")) dlg.close();
  });
  for (const b of document.querySelectorAll("[data-feedback]")) {
    b.addEventListener("click", (e) => {
      e.preventDefault();
      open();
    });
  }
  form.message.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) form.requestSubmit();
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    ok.hidden = err.hidden = true;
    send.disabled = true;
    send.textContent = send.dataset.busy!;
    const data = Object.fromEntries(new FormData(form));
    // FormSubmit mails the post to the studio address. See specs/feedback.md.
    const body = { ...data, _subject: "Feedback from workbench-soft.com", _template: "table", _captcha: "false", lang: form.dataset.lang, page: location.href };
    try {
      const res = await fetch(`https://formsubmit.co/ajax/${email}`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(body),
      });
      const json = (await res.json()) as { success?: string | boolean };
      if (!res.ok || String(json.success) !== "true") throw new Error(JSON.stringify(json));
      form.reset();
      ok.hidden = false;
    } catch (x) {
      console.error("Feedback failed", x);
      err.hidden = false;
    } finally {
      send.disabled = false;
      send.textContent = send.dataset.idle!;
    }
  });
</script>

<style>
  .fab {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 39;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(120deg, var(--cyan), var(--violet));
    color: var(--bg);
    font: 700 14px var(--sans);
    cursor: pointer;
    box-shadow: 0 10px 40px -8px rgb(0 0 0 / 0.8), 0 0 28px rgb(92 242 255 / 0.45);
    transition: box-shadow 0.2s, translate 0.2s var(--ease);
  }
  .fab:hover { translate: 0 -2px; box-shadow: 0 14px 44px -8px rgb(0 0 0 / 0.8), 0 0 40px rgb(92 242 255 / 0.65); }
  dialog {
    width: min(520px, calc(100vw - 32px));
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: 16px;
    background: rgb(10 14 26 / 0.97);
    color: var(--text);
    box-shadow: 0 30px 120px -20px rgb(0 0 0 / 0.9), 0 0 0 1px rgb(92 242 255 / 0.1);
  }
  dialog[open] { animation: pop 0.22s var(--ease); }
  @keyframes pop { from { opacity: 0; scale: 0.96; } }
  dialog::backdrop { background: rgb(2 3 8 / 0.6); backdrop-filter: blur(6px); }
  form { display: grid; gap: 14px; padding: 22px 24px 24px; }
  header { display: flex; align-items: start; justify-content: space-between; gap: 16px; }
  h2 { margin: 0; max-width: none; font-size: 1.35rem; line-height: 1.25; }
  .x { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--line); border-radius: 8px; background: none; color: var(--muted); cursor: pointer; }
  .x:hover { color: var(--text); border-color: var(--line-2); }
  .intro { margin: 0; color: var(--muted); font-size: 14px; }
  label { display: grid; gap: 6px; }
  label span { font: 500 12px var(--mono); letter-spacing: 0.04em; color: var(--soft); }
  textarea, input { width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid var(--line-2); border-radius: 10px; background: var(--bg-2); color: var(--text); font: 400 15px var(--sans); }
  textarea { resize: vertical; min-height: 110px; }
  textarea:focus, input:focus { outline: 0; border-color: var(--cyan); }
  .honey { position: absolute; left: -9999px; width: 1px; height: 1px; }
  .status { margin: 0; font-size: 14px; min-height: 1.4em; }
  .ok { color: var(--lime); }
  .err { color: #ff8a8a; }
  .err a { color: inherit; }
  .cta { display: flex; justify-content: end; }
  @media (max-width: 640px) {
    .fab { padding: 12px 14px; }
  }
  @media print {
    .fab { display: none; }
  }
</style>
