---
// The closed test page: why, the steps, then each app with its Join and Install links.
import Base from "../layouts/Base.astro";
import LangPicker from "../components/LangPicker.astro";
import { locales, pathOf, type Lang } from "../i18n/locales";
import { apps, feedback, group, installUrl, joinUrl } from "./apps";
import { catalogs, parts } from "./i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = catalogs[lang];
const path = "/testers/";
const href = (l: Lang) => (l === "en" ? path : `/${l}${path}`);
const links: Record<string, { href: string; text: string }> = {
  group: { href: group, text: "workbench-soft-testers" },
  email: { href: `mailto:${feedback}`, text: feedback },
};
---

<Base title={`${t.title} | Workbench Soft`} description={t.description} path={path}>
  <header class="top">
    <div class="bar">
      <a class="brand" href={pathOf(lang)}>{t.home}</a>
      <LangPicker lang={lang} items={locales.map((l) => ({ lang: l, href: href(l) }))} label={t.language} />
    </div>
  </header>
  <main class="page">
    <h1>{t.title}</h1>
    <p class="lede">{t.why}</p>
    <h2>{t.stepsTitle}</h2>
    <ol>
      {
        t.steps.map((step) => (
          <li>{parts(step).map((p, i) => (i % 2 ? <a href={links[p].href}>{links[p].text}</a> : p))}</li>
        ))
      }
    </ol>
    <p class="note">{t.notAvailable}</p>
    <h2>{t.appsTitle}</h2>
    <ul class="apps">
      {
        apps.map((app) => (
          <li>
            <h3>{app.name}</h3>
            <p>{t.apps[app.id]}</p>
            <p class="buttons">
              <a class="go" href={joinUrl(app.id)}>{t.join}</a>
              <a class="go ghost" href={installUrl(app.id)}>{t.install}</a>
            </p>
          </li>
        ))
      }
    </ul>
    <p class="lede">{parts(t.feedback).map((p, i) => (i % 2 ? <a href={links[p].href}>{links[p].text}</a> : p))}</p>
  </main>
  <footer class="foot">
    <span>© {new Date().getFullYear()} Workbench Soft</span>
  </footer>
</Base>

<style>
  .bar, .page, .foot { max-width: 820px; margin: 0 auto; padding: 0 var(--gutter); }
  .top { border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 56px; }
  .brand { font-family: var(--mono); letter-spacing: 0.04em; color: var(--text); text-decoration: none; font-weight: 500; }
  .page { padding-top: 40px; padding-bottom: 40px; }
  h1 { font-size: clamp(30px, 5vw, 44px); line-height: 1.12; margin: 8px 0 14px; }
  h2 { font-size: 24px; margin: 40px 0 12px; }
  h3 { font-size: 19px; margin: 0 0 4px; }
  p, li { color: var(--soft); font-size: 17px; line-height: 1.7; }
  a { color: var(--cyan); overflow-wrap: anywhere; }
  .lede { font-size: 19px; color: var(--text); }
  .note { font-size: 15px; color: var(--muted); border-left: 3px solid var(--violet); padding-left: 12px; }
  .apps { list-style: none; padding: 0; display: grid; gap: 14px; }
  .apps li { padding: 18px 20px; border: 1px solid var(--line-2); border-radius: 14px; background: var(--bg-2); }
  .apps p { margin: 0 0 12px; }
  .buttons { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 !important; }
  .go { display: inline-block; padding: 8px 16px; border-radius: 999px; background: var(--cyan); color: var(--bg); text-decoration: none; font-weight: 600; font-size: 15px; }
  .go.ghost { background: transparent; color: var(--cyan); border: 1px solid var(--cyan); }
  .foot { padding-top: 24px; padding-bottom: 40px; border-top: 1px solid var(--line); color: var(--dim); font: 500 12px var(--mono); }
</style>
